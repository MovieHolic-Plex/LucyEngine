# Copy to .env. Everything is optional: without a key the editor still opens and hand editing works.

# Agent (Claude). Needed for chat-driven editing.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=            # only if you go through a proxy
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium            # low | medium | high | xhigh | max

# Image generation (a Gemini-format image endpoint). Needed for brand-new art.
# Falls back to ANTHROPIC_BASE_URL / ANTHROPIC_API_KEY when unset.
# IMAGE_API_BASE=https://generativelanguage.googleapis.com
# IMAGE_API_KEY=
# IMAGE_MODEL=gemini-3.1-flash-image
# IMAGE_RPM=10
# IMAGE_GENERATION=off           # use only the built-in starter kit

# Server
# PORT=8787
# HOST=0.0.0.0
# DATA_DIR=./data
